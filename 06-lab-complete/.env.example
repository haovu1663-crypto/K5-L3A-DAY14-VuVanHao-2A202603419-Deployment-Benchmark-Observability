# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng:  cp .env.example .env   (file .env đã nằm trong .gitignore)
# ============================================================

# --- Server ---
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Security ---
# Tự sinh một chuỗi ngẫu nhiên dài, ví dụ:  python -c "import secrets; print(secrets.token_hex(24))"
# Để trống thì /ask từ chối mọi request (401).
AGENT_API_KEY=

# --- Redis (rate limit + cost guard) ---
# Chạy local:           redis://localhost:6379/0
# Trong docker compose: redis://redis:6379/0  (compose tự đặt)
REDIS_URL=redis://localhost:6379/0

# --- Giới hạn ---
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
